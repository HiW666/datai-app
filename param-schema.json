     "dt": 0,
     "picker": null,
     "meta": {
      "bitFields": [
       {
        "bit": 0,
        "name": "一键翘头",
        "desc": "拧电门就自动抬头、并稳住角度，不用手动控力防翻车。\n仅限封闭场地／赛道，严禁公共道路使用。"
       },
       {
        "bit": 1,
        "name": "安装方向",
        "desc": "0:朝上0° 1:朝上180°"
       }
      ]
     },
     "Signalvalue": 0
    },
